from datetime import datetime

# Authentication System

class AuthenticationSystem:
    def __init__(self):
        self.users = {}           # Stores registered users
        self.currentUser = None   # Currently logged-in user
        self.lastUserID = None    # Last attempted login ID

    def register(self, user):
        self.users[user.userID] = user
        print(f" User '{user.name}' registered with ID {user.userID}")

    def login(self, userID, password):
        self.lastUserID = userID
        user = self.users.get(userID)

        if user and user.verifyPassword(password):
            self.currentUser = user
            print(f"\n Login OK. Welcome, '{user.name}'!")
            return user
        print(f"\n Oops! Login failed. Check your user ID or password.")
        return None
        
    def logout(self):
        if self.currentUser:
            print(f"Goodbye. {self.currentUser.name} logged out.")
        self.currentUser = None

# USER CLASSES
# Base class representing a system user (Encapsulation & Abstraction)
class User:
  
    def __init__(self, userID, name, email, password):
        # Protected attributes
        self.userID = userID # Encapsulated attribute
        self.name = name     # Encapsulated attribute
        self.email = email  # Encapsulated attribute
        self._password = password  # Encapsulated attribute
        self.active = True

    # Getters
    def verifyPassword(self, password):
        return self._password == password

    def showDetails(self):
        # Display user details (can be overridden)
        return f"{self.name} ({self.__class__.__name__})"

    def viewDashboard(self):
        return f"Default dashboard for {self.name}"

    def displayProfile(self):
        print("\n--- User Profile ---")
        profile = {
            "User ID": self.userID,
            "Name": self.name,
            "Email": self.email,
            "Role": self.__class__.__name__
        }
        print("--------------------")
        return profile


    def updateProfile(self, name=None, email=None):
        changes = []
        # Update name if a new one is given
        if name:
            self.name = name
            changes.append(f"Name updated to {name}")

        # Update email if a new one is given
        if email:
            if "@" not in email:
                return "Invalid email format. Update cancelled."
            self.email = email
            changes.append(f"Email updated to {email}")
        return changes or "No changes were provided for the profile."
            
    def deactivateAccount(self):
        self.active = False

    def viewProject(self, project):
        return project.generateReport()

# TeamLeader Class

class TeamLeader(User):

    def showDetails(self):
        # Override User.showDetails
        return f"TeamLeader: {self.name}"

    def viewDashboard(self, team=None):
        print("\n=== Team Leader Dashboard ===")
        dashboard = {
            "Role": "Team Leader",
            "Name": self.name,
            "Team": team.teamName if team else "No team",
            "Members": len(team.members) if team else 0,
            "Project": team.project.title if team and team.project else "No project",
            "Meetings": len(team.meetings) if team else 0
        }

        print("=============================")
        return dashboard

    def createProject(self, team, project):
        # Team leader creates and links a project to their team
        # This is only done once per team
        team.project = project

    def assignTask(self, task, member, team):
        if member not in team.members:
            raise ValueError(f"{member.name} is not part of team '{team.teamName}'")
        task.member = member
        task.notify(f"{member.name} has been assigned to task '{task.title}'")

    def scheduleMeeting(self, team, meeting):
        team.meetings.append(meeting)

# TeamMember Class

class TeamMember(User):

    def __init__(self, userID, name, email, password):
        super().__init__(userID, name, email, password)
        self.completedTasks = 0

    def viewDashboard(self):
        return {
            "Role": "Team Member",
            "Name": self.name,
            "Completed Tasks": self.completedTasks
        }

    def updateTask(self, task, status="Done", comment=None, notify=True):
        # Update task status and optionally add a comment
        task.updateStatus(status, notify, comment)
        if status == "Done":
            self.completedTasks += 1

    def joinTeam(self, team, authSystem):
        return team.addMember(self, authSystem)

    def givePeerFeedback(self, feedbackSystem, reviewee, comment, rating):
        feedbackSystem.giveFeedback(self.name, reviewee.name, comment, rating)

# Lecturer Class
# Polymorphism
#This override allows Lecturers to see project progress without modifying the original User class
class Lecturer(User):

    def viewDashboard(self):
        return {
            "Role": "Lecturer",
            "Name": self.name,
            "Access": "View all team progress and reports"
        }

    def viewProject(self, project):
        return {"Project": project.title, "Progress (%)": project.calculateProgress()}

    def reviewReport(self, project):
        return project.generateReport()

    def trackTeamPerformance(self, team):
        if not team.project:
            return "No project assigned to this team."
        return {
            "Team": team.teamName,
            "Project": team.project.title,
            "Progress (%)": team.project.calculateProgress()
        }

# TEAM & PROJECT

class Team:
    # Team size is limited to avoid overload
    MAX_MEMBERS = 4  # Total including the leader

    def __init__(self, teamID, teamName, leader):
        self.teamID = teamID
        self.teamName = teamName
        self.leader = leader
        self.members = []
        self.project = None
        self.meetings = []

    def addMember(self, member, authSystem):
        # Check login
        if not authSystem.currentUser:
            print("You must log in first to add members.")
            return False

        # Check authorization
        if authSystem.currentUser != self.leader:
            print("Only the team leader can add members.")
            return False

        # Capacity check
        # Add a member if max limit not exceeded
        total_members = len(self.members) + 1  # +1 for leader
        if total_members >= Team.MAX_MEMBERS:
            print(f"Team '{self.teamName}' already has the maximum of {Team.MAX_MEMBERS} members")
            return False
        
        self.members.append(member)
        print(f" Member '{member.name}' added to team '{self.teamName}'")
        return True

    def removeMember(self, leader, member):
       # Authorization check
        if leader != self.leader:
            raise PermissionError("Only the team leader can remove members")

        # Safety check
        if member not in self.members:
            print(" Member not found in team")
            return

        self.members.remove(member)
        print(f" Member '{member.name}' removed from team '{self.teamName}'")


    def showDetails(self):
        return {
            "Team ID": self.teamID,
            "Team Name": self.teamName,
            "Leader": self.leader.name,
            "Members": [m.name for m in self.members],
            "Project": self.project.title if self.project else "No project assigned",
            "Meetings Scheduled": len(self.meetings)
        }

    def updateTeam(self, name=None, leader=None):
        # Update team name or leader
        if name:
            self.teamName = name
        if leader:
            self.leader = leader

    def deleteTeam(self):
        self.members.clear()
        self.project = None
        self.meetings.clear()

    def sendMessage(self, sender, message):
        notifications = []
        recipients = self.members + [self.leader]

        for member in recipients:
            if member != sender:
                notifications.append(f"Message from {sender.name}: {message}")
        return notifications

# Project Class

class Project:

    def __init__(self, projectID, title):
        self.projectID = projectID
        self.title = title
        self.tasks = []

    def createTask(self, task):
        self.tasks.append(task)
        print(f" Task '{task.title}' created in project '{self.title}'")

    def deleteTask(self, taskID):
        # Simple removal without notification
        self.tasks = [t for t in self.tasks if t.taskID != taskID]

    def updateProject(self, title=None):
        if title:
            self.title = title

    def deleteProject(self):
        self.tasks.clear()

    def calculateProgress(self):
        if not self.tasks:
            return 0
        done = sum(1 for t in self.tasks if t.status == "Done")
        return round((done / len(self.tasks)) * 100, 2)

    def generateReport(self):
        return {
            "Project": self.title,
            "Progress (%)": self.calculateProgress(),
            "Tasks": [(t.title, t.status) for t in self.tasks]
        }

# TASK & COMMENT

class Task:

    def __init__(self, taskID, title, description, member, deadline, priority):
        self.taskID = taskID
        self.title = title
        self.description = description
        self.member = member
        self.deadline = deadline
        self.priority = priority
        self.status = "To Do"
        self.lastUpdated = datetime.now()
        self.comments = []
        self.notifications = []

    # Status update
    def updateStatus(self, status, notify=True, comment=None):
        if status not in ["To Do", "In Progress", "Done"]:
            print("Invalid task status")
            return
        self.status = status
        self.lastUpdated = datetime.now()
        if notify:
            self.notify(f"Task '{self.title}' updated to '{status}'")
        if comment:
            self.addComment(self.member.name, comment)

    # Notifications
    def notify(self, message):
        # Add message to notifications and print it
        self.notifications.append(message)
        print(f"{message}")

    # Comment collection management
    def addComment(self, author, text):
        comment = Comment(author, text)
        self.comments.append(comment)
        print(f" '{author}' commented on task '{self.title}'")

    def updateComment(self, index, newText):
        if 0 <= index < len(self.comments):
            self.comments[index].update(newText)
        else:
            print("Invalid comment index")

    def removeComment(self, index):
        if 0 <= index < len(self.comments):
            self.comments[index].delete()
        else:
            print("Invalid comment index")

    def showComments(self):
        if not self.comments:
            print(f"No comments yet for task '{self.title}'")
            return
        print(f"\n--- Comments for task '{self.title}' ---")
        for i, c in enumerate(self.comments):
            print(f"{i}: {c.show()}")


class Comment:

    def __init__(self, author, text):
        self.author = author
        self.text = text
        self.timestamp = datetime.now()

    # Read 
    def show(self):
        return f"{self.author} ({self.timestamp:%Y-%m-%d %H:%M}): {self.text}"

    # Update
    def update(self, newText):
        self.text = newText
        print(f"Comment by {self.author} updated to: {self.text}")

    # Delete
    def delete(self):
        # Soft delete to preserve comment history
        self.text = "[deleted]"
        print(f"Comment by {self.author} has been deleted")


# MEETING & FEEDBACK

class Meeting:

    def __init__(self, meetingID, agenda, dateTime=None):
        self.meetingID = meetingID
        self.agenda = agenda
        self.dateTime = dateTime
        self.isScheduled = False
        self.isCancelled = False

    def scheduleMeeting(self, dateTime):
        self.dateTime = dateTime
        self.isScheduled = True
        self.isCancelled = False
        print(f" Meeting '{self.meetingID}' scheduled at {self.dateTime}")
        return f"Meeting {self.meetingID} scheduled at {self.dateTime}"

    def cancelMeeting(self):
        if not self.isScheduled:
            print(f" Attempted to cancel unscheduled meeting '{self.meetingID}'")
            return "Meeting is not scheduled."
        self.isScheduled = False
        self.isCancelled = True
        print(f" Meeting '{self.meetingID}' cancelled")
        return f"Meeting {self.meetingID} has been cancelled."

    def notifyMembers(self, members):
        return [f"Notification sent to {m.name} about meeting {self.meetingID}" for m in members]

class Feedback:

    def __init__(self, reviewer=None, reviewee=None, comment=None, rating=None):
        self.reviewer = reviewer
        self.reviewee = reviewee
        self.comment = comment
        self.rating = rating
        self._feedbackList = []

    def giveFeedback(self, reviewer, reviewee, comment, rating):
        # Basic validation for rating
        if rating < 1 or rating > 5:
            print("Rating must be between 1 and 5")
            return

        self.reviewer = reviewer
        self.reviewee = reviewee
        self.comment = comment
        self.rating = rating

        feedback = {
            "Reviewer": reviewer,
            "Reviewee": reviewee,
            "Comment": comment,
            "Rating": rating
        }

        self._feedbackList.append(feedback)
        print(f" Feedback added by '{reviewer}' for '{reviewee}' with rating {rating}")

    def updateFeedback(self, index, comment=None, rating=None):
        if 0 <= index < len(self._feedbackList):
            if comment:
                self._feedbackList[index]["Comment"] = comment
            if rating:
                self._feedbackList[index]["Rating"] = rating
        else:
            raise IndexError("Feedback index out of range")

    def removeFeedback(self, index):
        if 0 <= index < len(self._feedbackList):
            self._feedbackList.pop(index)
        else:
            raise IndexError("Feedback index out of range")

    def generateSummary(self):
        if not self._feedbackList:
            return "No feedback available."
        average_rating = sum(f["Rating"] for f in self._feedbackList) / len(self._feedbackList)
        return {"Total Reviews": len(self._feedbackList), "Average Rating": round(average_rating, 2)}

    def showAllFeedback(self):
        return self._feedbackList

