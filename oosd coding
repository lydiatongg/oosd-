# Meeting Actions
def meeting_actions(user, team):
    print("1. Schedule Meeting")
    print("2. Cancel Meeting")
    choice = input("Choose: ")

    if choice == "1":
        if not isinstance(user, TeamLeader):
            print("Only leader can schedule meetings.")
            return
        agenda = input("Agenda: ")
        meeting = Meeting(f"M{len(team.meetings)+1}", agenda)
        time = input("Date & Time: ")
        meeting.scheduleMeeting(time)
        team.meetings.append(meeting)

    elif choice == "2":
        if not team.meetings:
            print("No meetings.")
            return
        for m in team.meetings:
            print(f"- {m.meetingID}: {m.agenda}")
        mid = input("Meeting ID: ")
        meeting = next((m for m in team.meetings if m.meetingID == mid), None)
        if meeting and isinstance(user, TeamLeader):
            meeting.cancelMeeting()


