        return

    print("\n=== Team Actions ===")
    print("1. Add Member")
    print("2. Remove Member")
    choice = input("Choose an option: ").strip()

    if choice == "1":
        # Show available members not already in the team
        available_members = [m for m in members if m not in team.members]
        if not available_members:
            print("No available members to add.")
            return

        print("Available members to add:")
        for m in available_members:
            print(f"- {m.name}")

        name = input("Enter member name to add: ").strip()
