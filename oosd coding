    elif choice == "2":
        for m in team.members:
            print(f"- {m.name}")

        name = input("Enter member name: ")
        member = next((m for m in team.members if m.name == name), None)
        if member:
            team.removeMember(user, member)
        else:
            print("Member not found.")

