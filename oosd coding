from datetime import datetime

# Meeting Actions
def meeting_actions(user, team):
    print("1. Schedule Meeting")
    print("2. Cancel Meeting")
    choice = input("Choose an option: ").strip()

    if choice == "1":
        if not isinstance(user, TeamLeader):
            print("Only the team leader can schedule meetings.")
            return

        agenda = input("Agenda: ").strip()
        time_str = input("Date & Time (YYYY-MM-DD HH:MM AM/PM): ").strip()

        # Convert input string to datetime object (12-hour format)
        try:
            meeting_time = datetime.strptime(time_str, "%Y-%m-%d %I:%M %p")
        except ValueError:
            print("Invalid datetime format. Use YYYY-MM-DD HH:MM AM/PM")
            return

        # Check for duplicates (ignore cancelled meetings)
        duplicate = any(
            m.dateTime == meeting_time and not m.isCancelled for m in team.meetings
        )
        if duplicate:
            print(f"A meeting is already scheduled at {meeting_time:%Y-%m-%d %I:%M %p}. Cannot schedule duplicate.")
            return

        # Create and schedule meeting
        meeting = Meeting(f"M{len(team.meetings)+1}", agenda)
        meeting.scheduleMeeting(team, meeting_time)

        # Sort meetings by date/time
        team.meetings.sort(key=lambda m: m.dateTime)

    elif choice == "2":
        if not team.meetings:
            print("No meetings scheduled.")
            return

        # Show meetings sorted
        print("Scheduled Meetings:")
        for m in sorted(team.meetings, key=lambda x: x.dateTime):
            status = "Cancelled" if m.isCancelled else "Scheduled"
            print(f"- {m.meetingID}: {m.agenda} at {m.dateTime:%Y-%m-%d %I:%M %p} [{status}]")

        mid = input("Meeting ID to cancel: ").strip()
        meeting = next((m for m in team.meetings if m.meetingID == mid), None)
        if meeting:
            if isinstance(user, TeamLeader):
                meeting.cancelMeeting()
            else:
                print("Only the team leader can cancel meetings.")
        else:
            print("Meeting not found.")
    else:
        print("Invalid choice. Please select 1 or 2.")


